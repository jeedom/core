parameters:
  level: 1
  paths:
    - core
    - desktop
    - install
    - mobile
  excludePaths:
    - vendor/*
    # Runtime et tests propres au conteneur, avec des chemins /var/www/html.
    - install/OS_specific/Docker/*
  tmpDir: .phpstan.cache
  reportUnmatchedIgnoredErrors: false
  bootstrapFiles:
    - 3rdparty/elfinder/php/autoload.php

includes:
  - phpstan-baseline.neon
